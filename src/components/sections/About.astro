---
import { Globe, Building2, Wrench } from "lucide-react";
import { t } from "../../i18n/utils";

const lang = Astro.currentLocale === "en" ? "en" : "es";
const about = t(lang, "home.about");
const icons = [Globe, Building2, Wrench];
---

<section id="nosotros" class="bg-white py-24 sm:py-32">
  <div class="mx-auto max-w-7xl px-6 lg:px-8">
    <div class="grid grid-cols-1 items-center gap-16 lg:grid-cols-2">
      <!-- Izquierda: Imagen corporativa -->
      <div class="relative aspect-[4/3] overflow-hidden rounded-3xl shadow-2xl">
        <img
          src="/images/corporativo/nosotros/equipo-oficina-asiaven.webp"
          alt={about.imageAlt}
          class="h-full w-full object-cover"
          loading="lazy"
          decoding="async"
        />
      </div>

      <!-- Derecha: Contenido -->
      <div>
        <h2 class="mt-4 text-4xl font-extrabold tracking-tight text-corporativo-gray sm:text-5xl">
          {about.heading}
        </h2>
        <p class="mt-6 text-lg leading-relaxed text-gray-600">
          {about.paragraph}
        </p>

        <dl class="mt-10 max-w-xl space-y-8 text-base leading-7 text-gray-600">
          {about.items.map((item, index) => {
            const Icon = icons[index];
            return (
              <div class="relative pl-12">
                <dt class="inline font-bold text-corporativo-gray">
                  <Icon className="absolute left-1 top-1 h-6 w-6 text-corporativo-blue" />
                  {item.title}
                </dt>
                <dd class="inline"> {item.description}</dd>
              </div>
            );
          })}
        </dl>
      </div>
    </div>
  </div>
</section>
