---
const affiliates = [
  {
    name: "AV Constructora",
    description:
      "Proyectos de infraestructura, obras civiles y desarrollo industrial.",
    image: "/images/corporativo/afiliadas/division-infraestructura.webp",
  },
  {
    name: "AV Elevators",
    description:
      "Soluciones en equipos de elevación, grúas y plataformas de trabajo en altura.",
    image: "/images/corporativo/afiliadas/division-movilidad-vertical.webp",
  },
  {
    name: "AV Maquinarias Pesadas",
    description:
      "Alquiler, venta y soporte de maquinaria pesada para minería y construcción.",
    image: "/images/corporativo/afiliadas/division-maquinaria.webp",
  },
  {
    name: "AV Tecnología",
    description:
      "Soluciones tecnológicas, automatización y desarrollo de sistemas industriales.",
    image: "/images/corporativo/afiliadas/division-tecnologia.webp",
  },
];
---

<section class="bg-gray-50 px-6 py-20 lg:px-8">
  <div class="mx-auto max-w-7xl">
    <div class="mx-auto max-w-3xl text-center">
      <span
        class="text-sm font-semibold uppercase tracking-widest text-corporativo-blue"
      >
        Empresas Asiaven
      </span>
      <h2
        class="mt-3 text-3xl font-bold tracking-tight text-corporativo-gray md:text-4xl lg:text-5xl"
      >
        Nuestras Divisiones Especializadas
      </h2>
      <p class="mt-5 text-base leading-relaxed text-gray-500 md:text-lg">
        El respaldo del Grupo Asiaven estructurado para atender cada sector
        estratégico.
      </p>
    </div>

    <div class="mt-14 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {
        affiliates.map(({ name, description, image }) => (
          <a
            href="#"
            class="group relative block h-80 overflow-hidden rounded-xl shadow-md transition-all duration-300 hover:scale-105 hover:shadow-xl sm:h-96"
          >
            {/* Estado normal: foto + overlay oscuro. Ambos se desvanecen en hover. */}
            <img
              src={image}
              alt={name}
              class="absolute inset-0 h-full w-full object-cover transition-opacity duration-300 group-hover:opacity-0"
              loading="lazy"
              decoding="async"
            />
            <div class="absolute inset-0 bg-black/50 transition-opacity duration-300 group-hover:opacity-0" />

            {/* Estado hover: fondo sólido del tema, se desvanece hacia adentro. */}
            <div class="absolute inset-0 bg-corporativo-gray opacity-0 transition-opacity duration-300 group-hover:opacity-100" />

            {/* Bloque de texto: anclado abajo (mt-auto) en ambos estados. El
               párrafo colapsado (max-h-0) no reserva espacio, así que el
               título queda pegado al borde inferior en reposo; al revelarse
               el párrafo en hover, el bloque crece "hacia arriba" y el
               título queda visualmente más alto dentro de la tarjeta. */}
            <div class="absolute inset-0 flex flex-col justify-end p-6">
              <h3 class="text-lg font-bold text-white transition-transform duration-300 group-hover:-translate-y-1 sm:text-xl">
                {name}
              </h3>
              <p class="mt-3 max-h-0 overflow-hidden text-sm leading-relaxed text-gray-200 opacity-0 transition-all duration-300 group-hover:max-h-40 group-hover:opacity-100">
                {description}
              </p>
            </div>
          </a>
        ))
      }
    </div>
  </div>
</section>
