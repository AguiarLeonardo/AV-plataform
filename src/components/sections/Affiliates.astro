---
const affiliates = [
  {
    name: "Asiaven Constructora",
    description:
      "Construcción civil, arquitectura industrial y soluciones de envasado de alta resistencia para proyectos de gran escala.",
    image: "/images/corporativo/afiliadas/division-infraestructura.webp",
  },
  {
    name: "Asiaven Elevators",
    description:
      "Ingeniería, instalación y mantenimiento de ascensores y escaleras mecánicas con estándares internacionales de seguridad.",
    image: "/images/corporativo/afiliadas/division-movilidad-vertical.webp",
  },
  {
    name: "Asiaven Motors",
    description:
      "Suministro y mantenimiento de maquinaria pesada, motores industriales y equipos automotrices para operaciones de alto rendimiento. Respaldamos cada unidad con soporte técnico especializado y disponibilidad de repuestos a nivel nacional.",
    image: "/images/corporativo/afiliadas/division-tecnologica-maquinaria.webp",
  },
];
---

<section class="bg-gray-50 px-6 py-20 lg:px-8">
  <div class="mx-auto max-w-7xl">
    <div class="mx-auto max-w-3xl text-center">
      <span class="text-sm font-semibold uppercase tracking-widest text-corporativo-blue">
        Empresas Asiaven
      </span>
      <h2 class="mt-3 text-3xl font-bold tracking-tight text-corporativo-gray md:text-4xl lg:text-5xl">
        Nuestras Divisiones Especializadas
      </h2>
      <p class="mt-5 text-base leading-relaxed text-gray-500 md:text-lg">
        El respaldo del Grupo Asiaven estructurado para atender cada sector estratégico.
      </p>
    </div>

    <div class="mt-14 grid grid-cols-1 gap-8 md:grid-cols-3">
      {affiliates.map(({ name, description, image }) => (
        <a href="#" class="group overflow-hidden rounded-xl bg-white shadow-md transition-shadow duration-300 hover:shadow-xl">
          <div class="relative overflow-hidden">
            <img
              src={image}
              alt={name}
              class="h-52 w-full object-cover transition-transform duration-500 group-hover:scale-105"
              loading="lazy"
              decoding="async"
            />
          </div>
          <div class="p-6">
            <h3 class="text-lg font-bold text-corporativo-gray transition-colors duration-200 group-hover:text-corporativo-blue">
              {name}
            </h3>
            <p class="mt-2 text-sm leading-relaxed text-gray-500">
              {description}
            </p>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>
