---
import { Volume2, VolumeX } from "lucide-react";
import { t } from "../../i18n/utils";
import { publicFileExists } from "../../utils/fileExists";

const lang = Astro.currentLocale === "en" ? "en" : "es";
const video = t(lang, "home.video");

// Video en inglés: mismo directorio y nombre que el español, sufijo -en (ver
// docs/ESTADO.md — la ruta con subcarpeta "corporativo" que se asumió en un
// momento nunca fue la convención real). Si falta cualquiera de los dos
// formatos en inglés, cae completo al par en español en vez de mezclar
// formatos de idiomas distintos o mostrar un reproductor vacío — mismo
// criterio que catalogPdfExists: si no hay archivo, no se ofrece.
const hasEnglishVideo =
  lang === "en" &&
  publicFileExists("videos", "video-corporativo-en.webm") &&
  publicFileExists("videos", "video-corporativo-en.mp4");
const videoWebm = hasEnglishVideo ? "/videos/video-corporativo-en.webm" : "/videos/video-corporativo.webm";
const videoMp4 = hasEnglishVideo ? "/videos/video-corporativo-en.mp4" : "/videos/video-corporativo.mp4";
---

<section class="w-full">
  <div
    class="relative h-[calc((100dvh-var(--header-height,88px))*1.08)] w-full overflow-hidden md:h-[calc((100dvh-var(--header-height,88px))*1.15)]"
  >
    <video
      id="corporate-video"
      class="h-full w-full bg-corporativo-gray object-cover"
      autoplay
      muted
      loop
      playsinline
      preload="metadata"
    >
      <source src={videoWebm} type="video/webm" />
      <source src={videoMp4} type="video/mp4" />
      <p class="flex h-full w-full items-center justify-center bg-corporativo-gray px-6 text-center text-sm text-gray-300">
        {video.fallbackText}
      </p>
    </video>

    <button
      type="button"
      id="corporate-video-mute-toggle"
      aria-label={video.activateSoundLabel}
      data-activate-label={video.activateSoundLabel}
      data-mute-label={video.muteLabel}
      aria-pressed="false"
      class="absolute bottom-8 right-8 z-10 flex h-10 w-10 items-center justify-center rounded-full bg-black/40 text-white backdrop-blur-sm transition-colors hover:bg-black/60"
    >
      <VolumeX id="corporate-video-icon-muted" className="h-5 w-5" />
      <Volume2 id="corporate-video-icon-unmuted" className="hidden h-5 w-5" />
    </button>
  </div>
</section>

<script>
  const video = document.getElementById("corporate-video") as HTMLVideoElement | null;
  const toggleButton = document.getElementById("corporate-video-mute-toggle");
  const iconMuted = document.getElementById("corporate-video-icon-muted");
  const iconUnmuted = document.getElementById("corporate-video-icon-unmuted");

  toggleButton?.addEventListener("click", () => {
    if (!video) return;
    video.muted = !video.muted;
    toggleButton.setAttribute("aria-pressed", String(!video.muted));
    const activateLabel = toggleButton.dataset.activateLabel ?? "";
    const muteLabel = toggleButton.dataset.muteLabel ?? "";
    toggleButton.setAttribute("aria-label", video.muted ? activateLabel : muteLabel);
    iconMuted?.classList.toggle("hidden", !video.muted);
    iconUnmuted?.classList.toggle("hidden", video.muted);
  });
</script>
