---
import { t } from "../../i18n/utils";

const lang = Astro.currentLocale === "en" ? "en" : "es";
const { mission, vision } = t(lang, "home.missionVision");
---

<section class="grid grid-cols-1 md:grid-cols-2">
  <!-- Misión (Izquierda) - Overlay semi-transparente, imagen visible -->
  <div class="relative flex min-h-[50dvh] items-center justify-center overflow-hidden md:min-h-[60dvh]">
    <img
      src="/images/corporativo/mision-vision/mision-equipo-campo.webp"
      alt={mission.imageAlt}
      class="absolute inset-0 h-full w-full object-cover"
      loading="lazy"
      decoding="async"
    />

    <div class="absolute inset-0 bg-gray-600/50" />

    <div class="relative z-10 max-w-prose px-8 py-16 text-center md:px-16 lg:px-20">
      <h2 class="text-3xl font-bold tracking-tight text-white md:text-4xl">
        {mission.heading}
      </h2>
      <p class="mt-5 text-base leading-relaxed text-white/90 md:text-lg">
        {mission.text}
      </p>
    </div>
  </div>

  <!-- Visión (Derecha) - Overlay azul corporativo, texto blanco -->
  <div class="relative flex min-h-[50dvh] items-center justify-center overflow-hidden md:min-h-[60dvh]">
    <img
      src="/images/corporativo/mision-vision/vision-horizonte-tecnologico.webp"
      alt={vision.imageAlt}
      class="absolute inset-0 h-full w-full object-cover"
      loading="lazy"
      decoding="async"
    />

    <div class="absolute inset-0 bg-corporativo-blue/85" />

    <div class="relative z-10 max-w-prose px-8 py-16 text-center md:px-16 lg:px-20">
      <h2 class="text-3xl font-bold tracking-tight text-white md:text-4xl">
        {vision.heading}
      </h2>
      <p class="mt-5 text-base leading-relaxed text-white/90 md:text-lg">
        {vision.text}
      </p>
    </div>
  </div>
</section>
