---
import "../styles/global.css";
import StoreFooter from "../components/store/StoreFooter.astro";

interface Props {
  title?: string;
  /** Páginas "Próximamente" (catálogo apagado, ver storeFlags.ts) lo pasan en true — no deben indexarse mientras muestren un cartel genérico en vez de contenido real. */
  noindex?: boolean;
}

const { title = "Asiaven Store", noindex = false } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Asiaven Store — Equipos de cómputo, servidores y soluciones tecnológicas para empresas." />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <title>{title}</title>
    {noindex && <meta name="robots" content="noindex,nofollow" />}
  </head>
  <body class="bg-white text-gray-900 antialiased">
    <slot />
    <StoreFooter />
  </body>
</html>
