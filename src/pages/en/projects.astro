---
import Layout from "../../layouts/Layout.astro";
import PageHeader from "../../components/ui/PageHeader.astro";
import ClientLogosCarousel from "../../components/react/ClientLogosCarousel.tsx";
import { MapPin, Download } from "lucide-react";
import en from "../../i18n/en";
import { publicFileExists } from "../../utils/fileExists";

// Sin versión en inglés por ahora (ver docs/ESTADO.md) — ambos idiomas
// descargan el mismo PDF hasta que exista un brochure propio en inglés.
const brochurePdfExists = publicFileExists("documentos", "brochure-asiaven.pdf");
---

<Layout title={en.seo.projects.title} description={en.seo.projects.description} routeKey="projects">
  <PageHeader
    bgImage="/images/corporativo/banners/paginas/banner-proyectos.webp"
    title={en.projects.pageTitle}
  />

  <div class="min-h-screen bg-gray-50 pb-20">
    <section class="max-w-5xl mx-auto px-4 py-16">
      <h2
        class="text-3xl md:text-4xl text-corporativo-gray font-bold text-center mb-12"
      >
        {en.projects.introHeading}
      </h2>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {
          en.projects.clients.map((cliente) => (
            <div class="p-8 border border-gray-200 rounded-xl bg-white shadow-sm hover:shadow-md transition-shadow flex flex-col justify-center border-l-4 border-l-corporativo-blue">
              <h3 class="text-2xl font-bold text-corporativo-gray mb-2">
                {cliente.nombre}
              </h3>
              <div class="flex items-center gap-2 text-gray-500 mb-4">
                <MapPin className="w-4 h-4 flex-shrink-0" />
                <span class="text-sm">{cliente.ubicacion}</span>
              </div>
              <span class="inline-block bg-blue-50 text-corporativo-blue text-xs font-semibold px-3 py-1 rounded-full uppercase tracking-wide w-fit">
                {cliente.sector}
              </span>
            </div>
          ))
        }
      </div>

      {brochurePdfExists && (
        <div class="mt-12 flex justify-center">
          <a
            href="/documentos/brochure-asiaven.pdf"
            download
            class="inline-flex w-fit items-center gap-2 rounded-lg border border-corporativo-blue px-6 py-3 text-sm font-semibold text-corporativo-blue transition-colors hover:bg-corporativo-blue hover:text-white no-underline"
          >
            <Download className="h-4 w-4" />
            {en.projects.brochureCta}
          </a>
        </div>
      )}

      <div class="mt-24">
        <h2 class="text-3xl md:text-4xl text-corporativo-gray font-bold text-center mb-12">
          {en.projects.clientsHeading}
        </h2>

        <ClientLogosCarousel client:visible />
      </div>
    </section>
  </div>
</Layout>
