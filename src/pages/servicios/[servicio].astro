---
import Layout from "../../layouts/Layout.astro";
import ServiceSlider from "../../components/react/ServiceSlider.tsx";
import ProductFeatureSlider from "../../components/react/ProductFeatureSlider.tsx";
import { services } from "../../data/services";
import { Download } from "lucide-react";
import { localize, t } from "../../i18n/utils";

export function getStaticPaths() {
  return services.map((service) => ({
    params: { servicio: service.slug },
    props: { service },
  }));
}

const { service } = Astro.props;
// Ruta 100% española esta fase (no traducida todavía), pero se deriva el
// locale igual que en cualquier otra página en vez de asumir "es" a mano:
// cuando esta ruta se traduzca en la Fase 1d, alcanza con que le llegue el
// locale correcto — no hay accesos .es literales que perseguir.
const lang = Astro.currentLocale === "en" ? "en" : "es";

// Subproductos (elevatorsData/escalatorsData ya no viven aquí — se movieron
// a services.ts como Service.subProducts). Se resuelven a strings planos
// antes de pasarlos a ProductFeatureSlider, que sigue sin saber nada de
// locales. Genérico: si otro servicio agrega subProducts mañana, esto
// funciona sin tocar el .astro.
const subProducts = service.subProducts?.map((subProduct) => ({
  title: localize(subProduct.title, lang),
  image: subProduct.image,
  features: localize(subProduct.features, lang),
  panorama360: subProduct.panorama360,
}));
---

<Layout title={`${localize(service.title, lang)} - Asiaven`}>
  <div class="max-w-7xl mx-auto px-4 pt-24 pb-16 md:pt-32 md:pb-24">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-start">
      <ServiceSlider images={service.images} client:load />

      <div class="prose prose-lg text-gray-700">
        <h1 class="text-4xl md:text-5xl font-bold text-gray-900 mb-6 leading-tight">
          {localize(service.title, lang)}
        </h1>
        {localize(service.fullDescription, lang).map((paragraph) => (
          <p class="mb-6 leading-relaxed">{paragraph}</p>
        ))}
        {service.slug === "tecnologia-y-telecomunicaciones" ? (
          <div class="mt-8 flex flex-col sm:flex-row gap-4 items-start sm:items-center w-full">
            <a
              href="/store"
              class="inline-flex w-fit items-center gap-2 rounded-lg bg-corporativo-blue px-6 py-3 text-sm font-semibold text-white shadow-lg transition-colors hover:bg-corporativo-blue/90 no-underline"
            >
              Ir a la tienda &rarr;
            </a>
            <a
              href="/soporte-tecnico"
              class="inline-flex w-fit items-center gap-2 rounded-lg border border-corporativo-blue px-6 py-3 text-sm font-semibold text-corporativo-blue transition-colors hover:bg-corporativo-blue hover:text-white no-underline"
            >
              Soporte Técnico &rarr;
            </a>
          </div>
        ) : service.slug === "envases" ? (
          <div class="flex flex-wrap items-center gap-4">
            <a
              href="/envases"
              class="inline-flex w-fit items-center gap-2 rounded-lg bg-corporativo-blue px-6 py-3 text-sm font-semibold text-white shadow-lg transition-colors hover:bg-corporativo-blue/90 no-underline"
            >
              Ver catálogo completo &rarr;
            </a>
            <a
              href="#"
              class="inline-flex w-fit items-center gap-2 rounded-lg border border-corporativo-blue px-6 py-3 text-sm font-semibold text-corporativo-blue transition-colors hover:bg-corporativo-blue hover:text-white no-underline"
            >
              <Download className="h-4 w-4" />
              Descargar catálogo (PDF)
            </a>
          </div>
        ) : (
          <a
            href="/contactanos"
            class="inline-flex w-fit items-center self-start gap-2 rounded-lg bg-corporativo-blue px-6 py-3 text-sm font-semibold text-white shadow-lg transition-colors hover:bg-corporativo-blue/90 no-underline"
          >
            Solicitar Cotización &rarr;
          </a>
        )}
      </div>
    </div>

    {subProducts && service.subProductsHeading && (
      <div class="mt-20">
        <h2 class="text-3xl font-bold mb-10 text-center text-corporativo-gray">
          {localize(service.subProductsHeading, lang)}
        </h2>
        <ProductFeatureSlider
          products={subProducts}
          prevLabel={t(lang, "services.carousel.prevLabel")}
          nextLabel={t(lang, "services.carousel.nextLabel")}
          viewer360={t(lang, "services.viewer360")}
          client:load
        />
      </div>
    )}
  </div>
</Layout>
