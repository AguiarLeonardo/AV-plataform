---
import Layout from "../../layouts/Layout.astro";
import ServiceSlider from "../../components/react/ServiceSlider.tsx";
import ProductFeatureSlider from "../../components/react/ProductFeatureSlider.tsx";
import { services, type SubProduct } from "../../data/services";
import { Download } from "lucide-react";
import { localize, t } from "../../i18n/utils";
import { getRouteHref, getServiceDetailUrls } from "../../i18n/routes";
import { catalogPdfExists } from "../../utils/pdfExists";
import { buildWhatsappHref } from "../../config/whatsapp";

const techCatalogPdfExists = catalogPdfExists("catalogo-tecnologia.pdf");
const envasesCatalogPdfExists = catalogPdfExists("catalogo-envases.pdf");

export function getStaticPaths() {
  return services.map((service) => ({
    params: { servicio: service.slug },
    props: { service },
  }));
}

const { service } = Astro.props;
// Ruta 100% española: su contraparte en inglés vive en un archivo aparte
// (src/pages/en/services/[service].astro), con su propio getStaticPaths
// sobre los slugs traducidos — mismo patrón que el resto del sitio
// (contactanos.astro / en/contact.astro), no una sola ruta sirviendo ambos
// locales.
const lang = "es" as const;
const detailUrls = getServiceDetailUrls(service.slug);

// Subproductos (elevatorsData/escalatorsData ya no viven aquí — se movieron
// a services.ts como Service.subProducts). Se resuelven a strings planos
// antes de pasarlos a ProductFeatureSlider, que sigue sin saber nada de
// locales. Genérico: si otro servicio agrega subProducts mañana, esto
// funciona sin tocar el .astro.
const subProducts = service.subProducts?.map((subProduct: SubProduct) => ({
  title: localize(subProduct.title, lang),
  image: subProduct.image,
  features: localize(subProduct.features, lang),
  panorama360: subProduct.panorama360,
}));

// El botón "Solicitar Cotización" abre WhatsApp con un mensaje precargado en
// vez de llevar a /contactanos — decisión del dueño del proyecto, sin CTA
// secundario hacia el formulario (quien lo prefiera llega por el navbar o
// el footer). Un mensaje por servicio, indexado por slug — t() con ruta
// literal no sirve aquí porque service.slug solo se conoce en runtime.
const whatsappMessages = t(lang, "services").whatsappQuote;
const whatsappHref = buildWhatsappHref(whatsappMessages[service.slug]);
---

<Layout title={`${localize(service.title, lang)} - Asiaven`} dynamicHreflang={detailUrls}>
  <div class="max-w-7xl mx-auto px-4 pt-24 pb-16 md:pt-32 md:pb-24">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-start">
      <ServiceSlider images={service.images} client:load />

      <div class="prose prose-lg text-gray-700">
        <h1 class="text-4xl md:text-5xl font-bold text-gray-900 mb-6 leading-tight">
          {localize(service.title, lang)}
        </h1>
        {localize(service.fullDescription, lang).map((paragraph) => (
          <p class="mb-6 leading-relaxed">{paragraph}</p>
        ))}
        {service.slug === "tecnologia-y-telecomunicaciones" ? (
          <div class="mt-8 flex flex-col sm:flex-row gap-4 items-start sm:items-center w-full">
            {techCatalogPdfExists && (
              <a
                href="/documentos/catalogos/catalogo-tecnologia.pdf"
                class="inline-flex w-fit items-center gap-2 rounded-lg bg-corporativo-blue px-6 py-3 text-sm font-semibold text-white shadow-lg transition-colors hover:bg-corporativo-blue/90 no-underline"
              >
                <Download className="h-4 w-4" />
                {t(lang, "services.detail.techCatalogPdfCta")}
              </a>
            )}
            <a
              href={getRouteHref("support", lang)}
              class="inline-flex w-fit items-center gap-2 rounded-lg border border-corporativo-blue px-6 py-3 text-sm font-semibold text-corporativo-blue transition-colors hover:bg-corporativo-blue hover:text-white no-underline"
            >
              {t(lang, "services.detail.supportCta")} &rarr;
            </a>
          </div>
        ) : service.slug === "envases" ? (
          <div class="flex flex-wrap items-center gap-4">
            <a
              href="/envases"
              class="inline-flex w-fit items-center gap-2 rounded-lg bg-corporativo-blue px-6 py-3 text-sm font-semibold text-white shadow-lg transition-colors hover:bg-corporativo-blue/90 no-underline"
            >
              {t(lang, "services.detail.catalogCta")} &rarr;
            </a>
            {envasesCatalogPdfExists && (
              <a
                href="/documentos/catalogos/catalogo-envases.pdf"
                class="inline-flex w-fit items-center gap-2 rounded-lg border border-corporativo-blue px-6 py-3 text-sm font-semibold text-corporativo-blue transition-colors hover:bg-corporativo-blue hover:text-white no-underline"
              >
                <Download className="h-4 w-4" />
                {t(lang, "services.detail.catalogPdfCta")}
              </a>
            )}
          </div>
        ) : service.slug === "recipientes-gas-licuado" ? (
          <div class="flex flex-wrap items-center gap-4">
            <a
              href={whatsappHref}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex w-fit items-center gap-2 rounded-lg bg-[#25D366] px-6 py-3 text-sm font-semibold text-white shadow-lg transition-colors hover:bg-[#1EBE57] no-underline"
            >
              <svg viewBox="0 0 24 24" class="h-4 w-4" fill="currentColor">
                <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51a12.8 12.8 0 0 0-.57-.01c-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413z" />
              </svg>
              {t(lang, "services.detail.quoteCta")}
            </a>
            <a
              href="/store/recipientes/gas-licuado"
              class="inline-flex w-fit items-center gap-2 rounded-lg border border-corporativo-blue px-6 py-3 text-sm font-semibold text-corporativo-blue transition-colors hover:bg-corporativo-blue hover:text-white no-underline"
            >
              {t(lang, "services.detail.viewProductCta")} &rarr;
            </a>
          </div>
        ) : (
          <a
            href={whatsappHref}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex w-fit items-center self-start gap-2 rounded-lg bg-[#25D366] px-6 py-3 text-sm font-semibold text-white shadow-lg transition-colors hover:bg-[#1EBE57] no-underline"
          >
            <svg viewBox="0 0 24 24" class="h-4 w-4" fill="currentColor">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51a12.8 12.8 0 0 0-.57-.01c-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413z" />
            </svg>
            {t(lang, "services.detail.quoteCta")}
          </a>
        )}
      </div>
    </div>

    {subProducts && service.subProductsHeading && (
      <div class="mt-20">
        <h2 class="text-3xl font-bold mb-10 text-center text-corporativo-gray">
          {localize(service.subProductsHeading, lang)}
        </h2>
        <ProductFeatureSlider
          products={subProducts}
          prevLabel={t(lang, "services.carousel.prevLabel")}
          nextLabel={t(lang, "services.carousel.nextLabel")}
          viewer360={t(lang, "services.viewer360")}
          client:load
        />
      </div>
    )}
  </div>
</Layout>
