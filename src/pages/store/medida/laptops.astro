---
import StoreLayout from "../../../layouts/StoreLayout.astro";
import StoreNavigation from "../../../components/react/StoreNavigation.tsx";
import { LaptopBTO } from "../../../components/react/BTOForm.tsx";
import ComingSoon from "../../../components/store/ComingSoon.astro";
import { STORE_CATALOG_LIVE } from "../../../config/storeFlags";
---

{!STORE_CATALOG_LIVE ? (
  <ComingSoon sectionName="Equipo a Medida" />
) : (
<StoreLayout title="Configurar Laptop Corporativa - Asiaven Store">
  <StoreNavigation client:load currentPath={Astro.url.pathname} />

  <main class="max-w-4xl mx-auto py-16 px-4">
    <LaptopBTO client:load />
  </main>
</StoreLayout>
)}
