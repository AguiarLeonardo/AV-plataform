---
import StoreLayout from "../../../layouts/StoreLayout.astro";
import StoreNavigation from "../../../components/react/StoreNavigation.tsx";
import {
  ChevronRight,
  Tag,
  FileCheck,
  ShieldCheck,
  Droplet,
  Gauge,
  Ruler,
  AlertTriangle,
  Layers,
} from "lucide-react";

// Único producto real de la Store hoy (ver docs/ESTADO.md) — a diferencia
// de store/producto/[slug].astro (126 productos de relleno del catálogo
// tech), este es un solo producto real con datos fijos, así que no hace
// falta getStaticPaths ni tomar datos de techCatalog.ts. Reutiliza el mismo
// patrón visual (galería a la izquierda, datos a la derecha, mismo
// comportamiento de miniaturas) en vez de inventar uno nuevo.
const productTitle = "Cilindro de Gas Licuado de Petróleo (GLP) de 10 kg";

const galleryThumbs = [
  "/images/store/productos/bombona-glp-10kg/bombona-glp-10kg-1.webp",
  "/images/store/productos/bombona-glp-10kg/bombona-glp-10kg-2.webp",
  "/images/store/productos/bombona-glp-10kg/bombona-glp-10kg-3.webp",
];

// Identificación y normativa: qué es el producto y bajo qué norma se
// fabrica — lo primero que necesita confirmar un comprador de un
// recipiente a presión, distinto de sus especificaciones técnicas.
const identification = [
  { label: "Producto", value: "Cilindro de Gas Licuado de Petróleo (GLP) de 10 kg, marca ASIAVEN", Icon: Tag },
  { label: "Código SENCAMER", value: "20649085-378302", Icon: FileCheck },
  { label: "Norma de fabricación", value: "COVENIN 649:1997", Icon: ShieldCheck },
];

// Especificaciones técnicas — reproducidas exactamente como las entregó el
// dueño del proyecto: sin redondear, sin reformular, sin convertir unidades.
const specs = [
  { label: "Medio a llenar", value: "Gas Licuado de Petróleo (GLP)", Icon: Droplet },
  { label: "Capacidad volumétrica", value: "> 24 L", Icon: Gauge },
  { label: "Capacidad máxima de carga", value: "10 kg", Icon: Gauge },
  { label: "Diámetro interno", value: "304 mm", Icon: Ruler },
  { label: "Presión de diseño", value: "1653 kPa", Icon: Gauge },
  { label: "Presión de prueba hidráulica", value: "3307 kPa", Icon: Gauge },
  { label: "Presión de estallido", value: "> 6614 kPa", Icon: AlertTriangle },
  {
    label: "Material del cuerpo",
    value: "Acero HP325 (estándar GB/T6653-2017, equivalente a SG325 según norma JIS)",
    Icon: Layers,
  },
];

// Se cotiza por WhatsApp, no hay precio ni carrito — mensaje precargado en
// vez de un enlace desnudo, para que el usuario no tenga que escribir de
// cero qué producto le interesa. Patrón a replicar en el corporativo (ver
// docs/ESTADO.md).
const whatsappMessage =
  "Hola, me interesa el cilindro de GLP de 10 kg de Asiaven. Quisiera solicitar una cotización.";
const whatsappHref = `https://wa.me/5822129924333?text=${encodeURIComponent(whatsappMessage)}`;
---

<StoreLayout title={`${productTitle} - Asiaven Store`}>
  <StoreNavigation client:load currentPath="/store/recipientes/gas-licuado" />

  <main class="mx-auto max-w-7xl px-4 py-10 sm:px-6">
    <nav aria-label="Breadcrumb" class="mb-6 flex flex-wrap items-center gap-1 text-xs text-gray-500">
      <a href="/" class="hover:text-gray-900">Inicio</a>
      <ChevronRight className="h-3 w-3 flex-shrink-0" />
      <a href="/store" class="hover:text-gray-900">Tienda</a>
      <ChevronRight className="h-3 w-3 flex-shrink-0" />
      <span class="font-medium text-gray-700">{productTitle}</span>
    </nav>

    <div class="flex flex-col gap-8 md:grid md:grid-cols-2 md:gap-12">
      <div>
        <div class="flex w-full items-center justify-center rounded-lg border border-gray-100 bg-gray-50 p-6 sm:p-10">
          <img
            id="main-product-image"
            src={galleryThumbs[0]}
            alt={productTitle}
            class="max-h-80 w-full object-contain sm:max-h-96"
            loading="eager"
            decoding="async"
          />
        </div>

        <div class="mt-4 flex gap-3 overflow-x-auto pb-2 snap-x [scrollbar-width:none] [-ms-overflow-style:none] [&::-webkit-scrollbar]:hidden">
          {galleryThumbs.map((thumb, index) => (
            <button
              type="button"
              class:list={[
                "thumbnail-trigger aspect-square w-20 flex-shrink-0 snap-start overflow-hidden rounded-md border bg-gray-50 p-1 transition-colors hover:border-corporativo-blue sm:w-24",
                index === 0 ? "border-corporativo-blue ring-2 ring-corporativo-blue" : "border-gray-200",
              ]}
              data-image-src={thumb}
              aria-label={`Ver imagen ${index + 1}`}
            >
              <img src={thumb} alt={`${productTitle} miniatura ${index + 1}`} class="h-full w-full object-contain" loading="lazy" decoding="async" />
            </button>
          ))}
        </div>
      </div>

      <div>
        <h1 class="text-3xl font-bold text-gray-900">{productTitle}</h1>
        <p class="mt-4 text-base leading-relaxed text-gray-600">
          Fabricamos y suministramos cilindros industriales certificados para el almacenamiento y distribución de
          gas licuado, cumpliendo con las normas técnicas de seguridad exigidas por el sector.
        </p>

        <div class="mt-8">
          <h2 class="mb-4 text-lg font-semibold text-gray-900">Identificación y normativa</h2>
          <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
            {identification.map(({ label, value, Icon }) => (
              <div class="rounded-md border border-gray-200 p-3">
                <Icon className="h-5 w-5 text-corporativo-blue" strokeWidth={1.5} />
                <p class="mt-2 text-xs font-medium uppercase tracking-wide text-gray-500">{label}</p>
                <p class="mt-0.5 text-sm font-semibold text-gray-900">{value}</p>
              </div>
            ))}
          </div>
        </div>

        <a
          href={whatsappHref}
          target="_blank"
          rel="noopener noreferrer"
          class="mt-8 inline-flex w-full items-center justify-center gap-2 rounded-lg bg-[#25D366] py-4 text-center text-base font-semibold text-white shadow-lg transition-colors hover:bg-[#1EBE57] no-underline"
        >
          <svg viewBox="0 0 24 24" class="h-5 w-5" fill="currentColor">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51a12.8 12.8 0 0 0-.57-.01c-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413z" />
          </svg>
          Solicitar cotización por WhatsApp
        </a>

        <!-- Specs Grid -->
        <div class="mt-10">
          <h2 class="mb-4 text-lg font-semibold text-gray-900">Especificaciones técnicas</h2>
          <div class="grid grid-cols-2 gap-4">
            {specs.map(({ label, value, Icon }) => (
              <div class="rounded-md border border-gray-200 p-3">
                <Icon className="h-5 w-5 text-corporativo-blue" strokeWidth={1.5} />
                <p class="mt-2 text-xs font-medium uppercase tracking-wide text-gray-500">{label}</p>
                <p class="mt-0.5 text-sm font-semibold text-gray-900">{value}</p>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </main>
</StoreLayout>

<script>
  const mainImage = document.getElementById("main-product-image") as HTMLImageElement | null;
  const thumbnails = document.querySelectorAll<HTMLButtonElement>(".thumbnail-trigger");
  const activeClasses = ["border-corporativo-blue", "ring-2", "ring-corporativo-blue"];

  thumbnails.forEach((thumbnail) => {
    thumbnail.addEventListener("click", () => {
      const newSrc = thumbnail.dataset.imageSrc;
      if (!mainImage || !newSrc) return;

      mainImage.src = newSrc;

      thumbnails.forEach((t) => {
        t.classList.remove(...activeClasses, "border-gray-200");
        t.classList.add("border-gray-200");
      });
      thumbnail.classList.remove("border-gray-200");
      thumbnail.classList.add(...activeClasses);
    });
  });
</script>
